{
  "name": "stockflow-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-style-bans.mjs",
    "format": "prettier --write \"{app,src,scripts}/**/*.{ts,tsx,mjs,css}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\" \".claude/hooks/__tests__/*.test.mjs\"",
    "sync:check": "node scripts/sync-check.mjs",
    "sync:add": "node scripts/sync-add.mjs",
    "sync:pull": "node scripts/sync-pull.mjs",
    "sync:ack": "node scripts/sync-ack.mjs",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir dist",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run test:scripts && pnpm run sync:check && pnpm run doctor && pnpm run export:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "sonner-native": "^0.27.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-import": "^2.32.0",
    "expo-doctor": "^1.21.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "jiti": "1.21.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
